# ============================================================================
#  Codex 重置监控 · 配置文件（.env）
# ============================================================================
#
#  使用方法：
#    1. 复制本文件为 .env：   cp .env.example .env
#    2. 按下面的注释逐项填写（服务启动时 run.sh 也会自动帮你创建 .env）
#    3. 重启服务生效：        bash run.sh
#
#  规则说明：
#    - "#" 开头的行是注释；所有配置项默认已注释，保持默认值即可运行
#    - 数据源 / 通知渠道：填了凭证就启用，留空就停用，没有额外的开关
#    - 也可以不建 .env，直接在系统环境变量或 launchd 的 EnvironmentVariables
#      里设置同名变量（系统环境变量优先级高于 .env 文件）
#
#  想先看效果？DEMO=1 bash run.sh 使用内置模拟数据，无需任何凭证。
# ============================================================================


# ----------------------------------------------------------------------------
# ① 基础设置（不填就用注释里的默认值）
# ----------------------------------------------------------------------------

# 面板名称：浏览器标签页标题与导航栏名称
MONITOR_SITE_NAME="Codex Reset Monitor"

# 监控的 X 账号，多个用英文逗号分隔（不带 @）
#MONITOR_ACCOUNTS=thsottiaux

# 轮询间隔（分钟）。越小越及时；用 twitterapi.io 时费用会随频率增加
#MONITOR_POLL_INTERVAL=5

# 面板展示与告警判定的回看窗口（小时）
#MONITOR_LOOKBACK_HOURS=24

# 面板服务监听地址与端口。只在本机看就用默认值；
# 改 0.0.0.0 可让局域网访问，请自行注意安全
MONITOR_HOST=0.0.0.0
MONITOR_PORT=8080


# ----------------------------------------------------------------------------
# ② 数据源（至少配置一个；两个都配时自动故障切换：twitterapi_io 失败自动用 rsshub）
# ----------------------------------------------------------------------------

# 【推荐首选】twitterapi.io 的 API Key（第三方抓取接口，按量计费，无需 X 账号）
#   获取：打开 https://twitterapi.io → 注册并充值 → 后台创建 API Key
#   费用参考：默认每 5 分钟增量拉取一次，月成本通常只要几美元（以官网价格为准）
#   留空 = 停用
TWITTERAPI_IO_KEY=

# 【免费兜底】RSSHub 实例地址（读取 /twitter/user/:账号 路由）
#   Twitter 路由必须自建 RSSHub 并配置 X 登录态，公共实例不可用。
#   ① 浏览器登录 x.com → F12 → Application(应用) → Cookies → https://x.com
#      复制 auth_token 的值（ct0 不需要，新版 RSSHub 运行时自动获取）
#   ② 启动自建实例，把 auth_token 通过 TWITTER_AUTH_TOKEN 传入
#      （多个账号可用英文逗号分隔做轮询）：
#      docker run -d --name rsshub -p 1200:1200 \
#        -e TWITTER_AUTH_TOKEN=你的auth_token diygod/rsshub
#   ③ 建议同时给实例配 ACCESS_KEY 鉴权（公网裸奔会被白嫖），
#      并在下方 RSSHUB_ACCESS_KEY 填同一个值
#   ④ 验证：http://实例地址/twitter/user/thsottiaux?key=你的ACCESS_KEY
#      能看到 XML 即成功
#   注意：auth_token 数周~数月会过期（重新登录 x.com 也会使旧值失效），
#   过期后此源显示"失败"，重新抓 Cookie 更新容器并重启即可
#   留空 = 停用
#RSSHUB_BASE_URL=http://127.0.0.1:1200
# RSSHub 的路由模板，一般不用改
#RSSHUB_ROUTE=twitter/user
# 如果你的 RSSHub 实例开启了鉴权（实例侧环境变量 ACCESS_KEY），这里填同一个值。
# 实例侧生成随机密钥：openssl rand -hex 16
#RSSHUB_ACCESS_KEY=


# ----------------------------------------------------------------------------
# ③ 告警通知渠道（想用哪个填哪个；全部留空 = 命中时只在面板展示）
#    填好后可在面板右上角点"发送测试通知"验证。
# ----------------------------------------------------------------------------

# 飞书群机器人：
#   群设置 → 群机器人 → 添加机器人 → "自定义机器人" → 复制 Webhook 地址
#FEISHU_WEBHOOK=

# 钉钉群机器人：
#   群设置 → 机器人 → 添加 → 自定义机器人；
#   安全设置务必选"自定义关键词"，关键词填：Codex重置监控（推送消息自带此前缀）
#DINGTALK_WEBHOOK=

# 企业微信群机器人：
#   群聊右键 → 添加群机器人 → 复制 Webhook 地址
#WECOM_WEBHOOK=

# Bark（iOS，手机弹窗）：
#   App Store 安装 Bark 打开 App，按下面格式填你自己的 Key
#   示例：https://api.day.app/AAAAAAAAA1111112222
#BARK_URL=

# Telegram Bot：
#   ① 给 @BotFather 发 /newbot 创建机器人，拿到 token（格式如 123456789:AAExxx）
#   ② 给 @userinfobot 发任意消息，查到你自己的 chat_id（纯数字）
#TG_BOT_TOKEN=
#TG_CHAT_ID=


# ----------------------------------------------------------------------------
# ④ 高级：自定义命中规则（一般不用动，内置规则已覆盖 Tibo 的历史措辞）
# ----------------------------------------------------------------------------
# 内置规则：
#   英文：同时命中 reset + usage/limits + (paid/everyone/all/codex/we...)
#   中文：同时命中 重置 + (用量/限额/额度/付费/订阅/全球)
# 确需自定义时，用 JSON 数组覆盖（同一条规则内所有正则全部命中才算命中）：
#MONITOR_RULES_JSON=[{"name":"重置公告","all_patterns":["reset","usage|limit"],"enabled":true}]


# ----------------------------------------------------------------------------
# ⑤ 运行环境
# ----------------------------------------------------------------------------
# production（默认）：隐藏"发送测试通知"按钮
# debug：面板显示"发送测试通知"，便于验证通知渠道
#MONITOR_ENV=production


# ----------------------------------------------------------------------------
# ⑥ 演示模式：设为 1 时使用内置模拟数据（含一条命中样例），无需任何凭证
# ----------------------------------------------------------------------------
#DEMO=1
