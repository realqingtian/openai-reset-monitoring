# ============================================================================
#  Codex 重置监控 · 配置文件（.env 示例）
# ============================================================================
#  使用方法：
#    1. 复制本文件为 .env：   cp .env.example .env
#    2. 按下面注释逐项填写（首次 bash start-backend.sh 也会自动创建 .env）
#    3. 改完重启生效：        bash start-backend.sh
#
#  说明：
#    - 带 # 的行是注释或未启用的配置项，去掉行首 # 即生效
#    - 数据源 / 通知渠道：填了凭证就启用，留空就停用，没有额外的开关
#    - 也可以不建 .env，改在系统环境变量里设置同名变量（优先级更高）
#
#  想先看效果？DEMO=1 bash start-backend.sh 用内置模拟数据体验，无需任何凭证（见第 1 节）
# ============================================================================

# ==================== 1. 运行模式与服务 ======================
# DEMO：设为 1 使用内置模拟数据体验，无需任何凭证
# MONITOR_ENV：production（默认）/ debug（dev、development 视同 debug）
#   debug 时面板右上角出现"发送测试通知"按钮，向所有已配置渠道发测试消息验证渠道
# MONITOR_SITE_NAME：面板名称（浏览器标签页标题 + 导航栏名称）
# MONITOR_HOST / MONITOR_PORT：面板监听地址与端口，默认 127.0.0.1:8080；
#   HOST 改 0.0.0.0 局域网可访问——请自行评估暴露风险（可在第 5 节开启登录鉴权）
# =================================================

#DEMO=1
#MONITOR_ENV=production
MONITOR_SITE_NAME="Codex Reset Monitor"
#MONITOR_HOST=127.0.0.1
#MONITOR_PORT=8080

# ==================== 2. 监控对象与节奏 ======================
# MONITOR_ACCOUNTS：监控的 X 账号，多个用英文逗号分隔（不带 @）
# MONITOR_POLL_INTERVAL：轮询间隔（分钟），越小越及时；用 twitterapi.io 时费用随之增加
# MONITOR_LOOKBACK_HOURS：面板展示与告警判定的回看窗口（小时）
# MONITOR_INCLUDE_REPLIES：是否同时监控回复（公告偶尔以回复补充，面板带「回复」徽章）；
#   默认 true，关闭必须显式设 false（注释掉无效）。RSSHub 源无法判定回复
# =================================================

#MONITOR_ACCOUNTS=thsottiaux
#MONITOR_POLL_INTERVAL=5
#MONITOR_LOOKBACK_HOURS=24
#MONITOR_INCLUDE_REPLIES=false

# ==================== 3. 数据源（至少配一个；两个都配时自动切换）======================
# TWITTERAPI_IO_KEY【付费首选】：第三方抓取接口，按量计费，无需 X 账号
#   获取：https://twitterapi.io 注册并充值 → 后台创建 API Key
#   费用参考：每 5 分钟增量拉取一次，月成本通常几美元（以官网价格为准）
# RSSHUB_BASE_URL【免费兜底】：自建 RSSHub 实例（Twitter 路由必须配 X 登录态，公共实例不可用）：
#   1. 浏览器登录 x.com → F12 → Application（应用）→ Cookies → https://x.com，
#      复制 auth_token 的值（ct0 不用管，新版 RSSHub 运行时自动获取）
#   2. 启动实例并传入 auth_token（多个逗号分隔可轮询）：
#        docker run -d --name rsshub -p 1200:1200 -e TWITTER_AUTH_TOKEN=你的token diygod/rsshub
#   3. 建议开启鉴权（公网裸奔会被白嫖）：容器再加 -e ACCESS_KEY=随机密钥（openssl rand -hex 16）
#   4. 验证 http://实例地址/twitter/user/thsottiaux?key=你的ACCESS_KEY 能看到 XML 即成功
#   注意：auth_token 数周~数月会过期，过期后该源显示"失败"，重新抓 Cookie 更新容器重启即可
# RSSHUB_ROUTE：路由模板，一般不用改；RSSHUB_ACCESS_KEY：实例开启鉴权时填同一个值
# =================================================

#TWITTERAPI_IO_KEY=

#RSSHUB_BASE_URL=http://127.0.0.1:1200
#RSSHUB_ROUTE=twitter/user
#RSSHUB_ACCESS_KEY=

# ==================== 4. 告警通知渠道（想用哪个填哪个）======================
# 全部留空 = 命中时只在面板展示，不推送。
# 验证方法：MONITOR_ENV 改 debug 并重启，面板右上角"发送测试通知"可向全部渠道发测试消息
# MONITOR_NOTIFY_LANG：推送文案语言，zh 中文（默认）/ en 英文；
#   只影响推送文案，面板语言跟随浏览器设置，互不影响
# =================================================

# 飞书群机器人：群设置 → 群机器人 → 添加机器人 → "自定义机器人" → 复制 Webhook 地址
#FEISHU_WEBHOOK=

# 钉钉群机器人：群设置 → 机器人 → 添加 → 自定义机器人；
#   安全设置务必选"自定义关键词"，关键词填 Codex重置监控（推送标题自带此前缀，能匹配上）
#DINGTALK_WEBHOOK=

# 企业微信群机器人：群聊右键 → 添加群机器人 → 复制 Webhook 地址
#WECOM_WEBHOOK=

# Bark（iOS 手机弹窗）：App Store 安装 Bark，按 App 内提示拿到你的 Key
#   格式示例：https://api.day.app/AAAAAAAAA1111112222
#BARK_URL=

# Telegram Bot（两行都填才启用）：
#   1. 给 @BotFather 发 /newbot 创建机器人，拿到 token（格式如 123456789:AAExxx）
#   2. 给 @userinfobot 发任意消息，查到你自己的 chat_id（纯数字）
#TG_BOT_TOKEN=
#TG_CHAT_ID=

#MONITOR_NOTIFY_LANG=zh

# ==================== 5. 登录鉴权（JWT，可选）======================
# 配置管理员密码后，「立即检查」等操作需登录，面板查看保持公开；留空（默认）不启用鉴权
# MONITOR_ADMIN_USER：管理员用户名（默认 admin）
# MONITOR_ADMIN_PASSWORD：管理员密码
# MONITOR_JWT_SECRET：JWT 签名密钥，留空则从口令派生（改口令即全量失效）
# MONITOR_TOKEN_EXPIRE_HOURS：登录态有效期（小时，默认 24）
# =================================================

#MONITOR_ADMIN_USER=admin
#MONITOR_ADMIN_PASSWORD=
#MONITOR_JWT_SECRET=
#MONITOR_TOKEN_EXPIRE_HOURS=24

# ==================== 6. 运维进阶（一般用默认值）======================
# MONITOR_SOURCE_ALERT_THRESHOLD / REPEAT_MINUTES：数据源自告警——连续 N 轮检查全部
#   失败后经已配置渠道发告警（0=关闭，默认 3）；未恢复时每隔 N 分钟重发（0=不重发，默认 60）
# MONITOR_TWEET_RETENTION_DAYS / HIT_RETENTION_DAYS：推文保留天数——未命中 30 天滚动清理，
#   命中延长到 180 天供「重置节奏」统计
# MONITOR_PUBLIC_URL：对外访问地址（可选，如 https://monitor.example.com），
#   配置后数据源自告警消息会附上面板链接
# =================================================

#MONITOR_SOURCE_ALERT_THRESHOLD=3
#MONITOR_SOURCE_ALERT_REPEAT_MINUTES=60
#MONITOR_TWEET_RETENTION_DAYS=30
#MONITOR_HIT_RETENTION_DAYS=180
#MONITOR_PUBLIC_URL=

# ==================== 7. 自定义命中规则（一般不用动）======================
# 内置规则已覆盖 Tibo 的历史措辞（同一条规则内所有关键词全部命中才触发，忽略大小写）：
#   英文：reset + usage/limits + (paid/everyone/all/codex/we…)
#   中文：重置 + (用量/限额/额度/付费/订阅/全球)
#   英文宽松：reset + usage/limits（兜底"I will reset usage limits…"这类预告）
# 确需自定义时，用 JSON 数组覆盖（结构与内置一致）；写错会自动回退内置规则并记日志
# =================================================

#MONITOR_RULES_JSON=[{"name":"重置公告","all_patterns":["reset","usage|limit"],"enabled":true}]

# ==================== 8. Docker Compose 部署 ======================
# FRONTEND_PORT：面板对外访问端口（Caddy 容器）；
# 后端 API 容器不对外发布端口，由 Caddy 反代 /api
# =================================================

#FRONTEND_PORT=80
