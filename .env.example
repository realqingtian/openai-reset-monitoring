# ============================================================================
#  Codex 重置监控 · 配置文件（.env 示例）
# ============================================================================
#  使用方法：
#    1. 复制本文件为 .env：   cp .env.example .env
#    2. 按下面注释逐项填写（首次 bash run.sh 也会自动创建 .env）
#    3. 改完重启生效：        bash run.sh
#
#  说明：
#    - 带 # 的行是注释或未启用的配置项，去掉行首 # 即生效
#    - 数据源 / 通知渠道：填了凭证就启用，留空就停用，没有额外的开关
#    - 也可以不建 .env，改在系统环境变量里设置同名变量（优先级更高）
#
#  想先看效果？DEMO=1 bash run.sh 用内置模拟数据体验，无需任何凭证（见 ④）
# ============================================================================

# ----------------------------------------------------------------------------
# ① 基础设置（不填就用内置默认值）
# ----------------------------------------------------------------------------

# 面板名称：浏览器标签页标题与导航栏名称
MONITOR_SITE_NAME="Codex Reset Monitor"

# 监控的 X 账号，多个用英文逗号分隔（不带 @）
#MONITOR_ACCOUNTS=thsottiaux

# 轮询间隔（分钟）：越小越及时；用 twitterapi.io 时费用会随之增加
#MONITOR_POLL_INTERVAL=5

# 面板展示与告警判定的回看窗口（小时）
#MONITOR_LOOKBACK_HOURS=24

# 面板服务监听地址与端口：只在本机看就填 127.0.0.1；
# 填 0.0.0.0 局域网内可访问，请自行注意安全
MONITOR_HOST=0.0.0.0
MONITOR_PORT=8080

# ----------------------------------------------------------------------------
# ② 数据源（至少配一个；两个都配时自动切换，twitterapi.io 失败自动改用 rsshub）
# ----------------------------------------------------------------------------

# 【付费首选】twitterapi.io 的 API Key：第三方抓取接口，按量计费，无需 X 账号
#   获取：打开 https://twitterapi.io → 注册并充值 → 后台创建 API Key
#   费用参考：每 5 分钟增量拉取一次，月成本通常只要几美元（以官网价格为准）
#TWITTERAPI_IO_KEY=

# 【免费兜底】自建 RSSHub 实例地址（走 /twitter/user/:账号 路由）
#   Twitter 路由必须给 RSSHub 配 X 登录态，公共实例不可用，步骤：
#   ① 浏览器登录 x.com → F12 → Application（应用）→ Cookies → https://x.com，
#      复制 auth_token 的值（ct0 不用管，新版 RSSHub 运行时自动获取）
#   ② 启动自建实例，把 auth_token 传给容器（多个 token 逗号分隔可轮询）：
#        docker run -d --name rsshub -p 1200:1200 \
#          -e TWITTER_AUTH_TOKEN=你的auth_token diygod/rsshub
#   ③ 建议给实例开启 ACCESS_KEY 鉴权（公网裸奔会被白嫖）：
#        容器再加 -e ACCESS_KEY=随机密钥（生成：openssl rand -hex 16）
#   ④ 验证：浏览器打开
#        http://实例地址/twitter/user/thsottiaux?key=你的ACCESS_KEY
#      能看到 XML 即成功，然后填下面的配置
#   注意：auth_token 数周~数月会过期（重新登录 x.com 也会使旧值失效），
#   过期后该源在面板显示"失败"，重新抓 Cookie 更新容器重启即可
#RSSHUB_BASE_URL=http://127.0.0.1:1200
# RSSHub 的路由模板，一般不用改
#RSSHUB_ROUTE=twitter/user
# 实例侧开启了 ACCESS_KEY 鉴权时，这里填同一个值
#RSSHUB_ACCESS_KEY=

# ----------------------------------------------------------------------------
# ③ 告警通知渠道（想用哪个填哪个；全部留空 = 命中时只在面板展示，不推送）
#    填好后怎么验证：见 ④，把 MONITOR_ENV 改成 debug 后面板右上角有"发送测试通知"
# ----------------------------------------------------------------------------

# 飞书群机器人：
#   群设置 → 群机器人 → 添加机器人 → "自定义机器人" → 复制 Webhook 地址
#FEISHU_WEBHOOK=

# 钉钉群机器人：
#   群设置 → 机器人 → 添加 → 自定义机器人；
#   安全设置务必选"自定义关键词"，关键词填：Codex重置监控
#   （推送标题自带【Codex重置监控】前缀，能匹配上）
#DINGTALK_WEBHOOK=

# 企业微信群机器人：
#   群聊右键 → 添加群机器人 → 复制 Webhook 地址
#WECOM_WEBHOOK=

# Bark（iOS 手机弹窗）：
#   App Store 安装 Bark，打开 App 按 App 内提示拿到你的 Key，按格式填写
#   示例：https://api.day.app/AAAAAAAAA1111112222
#BARK_URL=

# Telegram Bot（两行都填才启用）：
#   ① 给 @BotFather 发 /newbot 创建机器人，拿到 token（格式如 123456789:AAExxx）
#   ② 给 @userinfobot 发任意消息，查到你自己的 chat_id（纯数字）
#TG_BOT_TOKEN=
#TG_CHAT_ID=

# 推送消息语言：zh 中文（默认）/ en 英文。只影响推送文案，面板语言跟随浏览器设置
#MONITOR_NOTIFY_LANG=zh

# ----------------------------------------------------------------------------
# ④ 调试与演示
# ----------------------------------------------------------------------------
# 运行环境：production（默认）/ debug（dev、development 视同 debug）
#   debug 时面板右上角出现"发送测试通知"按钮，向所有已配置渠道发测试消息，
#   用于验证 ③ 的渠道是否配置正确；验证完改回 production 即可（不影响正常推送）
#MONITOR_ENV=production

# 演示模式：设为 1 使用内置模拟数据（含一条命中样例），无需任何凭证
#DEMO=1

# ----------------------------------------------------------------------------
# ⑤ 高级：自定义命中规则（一般不用动，内置规则已覆盖 Tibo 的历史措辞）
# ----------------------------------------------------------------------------
# 内置规则（同一条规则内所有关键词全部命中才触发，忽略大小写）：
#   英文：reset + usage/limits + (paid/everyone/all/codex/we…)
#   中文：重置 + (用量/限额/额度/付费/订阅/全球)
#   英文宽松：reset + usage/limits（兜底"I will reset usage limits…"这类预告）
# 确需自定义时，用 JSON 数组覆盖（结构与内置一致）；写错会自动回退内置规则并记日志：
#MONITOR_RULES_JSON=[{"name":"重置公告","all_patterns":["reset","usage|limit"],"enabled":true}]
